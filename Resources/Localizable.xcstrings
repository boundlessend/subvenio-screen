    "GitHub is rate limiting this network right now. The check works again within the hour.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub сейчас ограничивает запросы с этой сети. Проверка заработает в течение часа."
          }
        }
      }
    },
