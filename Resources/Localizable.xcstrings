    "The cursor moves inside the captured frame and lags by the whole pipeline delay, which reads as a laggy mouse.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсор попадёт внутрь кадра и будет отставать на всю задержку захвата: это ощущается как лаг мыши."
          }
        }
      }
    },
    "The display this effect was set to is no longer connected.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисплей, на который был назначен эффект, больше не подключён."
          }
        }
      }
    },
    "The selected preset does not read the screen. These settings apply to level 3 presets.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный пресет не читает экран. Эти настройки действуют для пресетов уровня 3."
          }
        }
      }
    },
    "The selected preset is no longer in the shaders folder. Pick another one.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
