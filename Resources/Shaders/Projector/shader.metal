// кинопроектор: ровный свет, углы уходят в тень
fragment float4 overlay_fragment(VertexOut in [[stage_in]],
                                 constant Uniforms &u [[buffer(0)]]) {
    // лампа не дышит. яркость всего кадра здесь не модулируется ни на какой частоте:
    // быстрая модуляция читается как мерцание и опасна для светочувствительных людей,
    // медленная читается как дыхание и мешает работать, а глубина у них одна и та же -
    // замедление её не убирает. всё движущееся в пресетах этого набора движется
    // локально: зерно, полоса развёртки, царапины
    float2 centered = (in.uv - 0.5) * 2.0;
    float vignette = smoothstep(0.35, 1.35, length(centered)) * vignetteStrength;

    return float4(0.0, 0.0, 0.0, saturate(vignette));
}
