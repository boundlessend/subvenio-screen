<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- только для запроса страницы релизов GitHub при проверке обновлений -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Pow приходит готовым xcframework и встраивается динамически, а Library
	     Validation из Hardened Runtime требует у него тот же team id, что у
	     приложения. у ad-hoc подписи team id нет ни у кого, поэтому проверка
	     заваливает загрузку и приложение не стартует вовсе. отключена именно
	     она, остальной Hardened Runtime на месте, и песочница тоже -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
